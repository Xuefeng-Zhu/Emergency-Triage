[Unit]
Description=Emergency Trial container stack
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/emergency-trial
ExecStartPre=/usr/bin/install -d -m 0777 /run/emergency-trial-postgres
ExecStartPre=/usr/bin/docker compose --profile tools run --rm migrate
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
