[Unit]
Description=Emergency Trial React UI
After=network.target emergency-trial-api.service

[Service]
Type=simple
User=dell
WorkingDirectory=/home/dell/Emergency-Trial
Environment=TRIAGE_API_URL=http://127.0.0.1:8787
ExecStart=/usr/bin/env pnpm --filter @emergency-trial/web preview --host 0.0.0.0 --port 4173
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
