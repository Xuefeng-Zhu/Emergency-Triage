# Runtime
TRIAGE_MODE=stub
TRIAGE_HOST=0.0.0.0
TRIAGE_PORT=8787
TRIAGE_DATABASE_PATH=./data/triage.sqlite3
TRIAGE_WEB_ORIGIN=http://localhost:5173

# WhisperX (used when TRIAGE_MODE=live)
WHISPERX_MODEL=large-v3
WHISPERX_DEVICE=cuda
WHISPERX_COMPUTE_TYPE=float16
WHISPERX_BATCH_SIZE=4
WHISPERX_LANGUAGE=en

# NemoClaw / OpenClaw / OpenShell (used when TRIAGE_MODE=live)
NEMOCLAW_SANDBOX=emergency-trial-agent
NEMOCLAW_TIMEOUT_SECONDS=90
MOCK_LIS_URL=http://host.openshell.internal:8787/mock-lis/orders
ORDER_PERMIT_SECRET=change-me-before-live-mode
