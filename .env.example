# Public origin. Use the Tailscale HTTPS hostname in production.
APP_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-use-at-least-32-random-bytes
INTERNAL_SERVICE_TOKEN=change-me-use-at-least-32-random-bytes

POSTGRES_DB=emergency_trial
POSTGRES_USER=emergency_trial
POSTGRES_PASSWORD=change-me-database-password
DATABASE_URL=postgresql://emergency_trial:change-me-database-password@localhost:5432/emergency_trial
DATABASE_URL_DOCKER=postgresql://emergency_trial:change-me-database-password@postgres:5432/emergency_trial
# Host systemd worker reaches the container through a password-protected Unix socket.
AGENT_DATABASE_URL=postgresql://emergency_trial:change-me-database-password@localhost/emergency_trial?host=%2Frun%2Femergency-trial-postgres

DATA_ROOT=./data
DATA_ROOT_CONTAINER=/data
AUDIO_RETENTION_DAYS=30
MAX_RECORDING_SECONDS=14400

WEB_PORT=3000
REALTIME_PORT=3001
CADDY_PORT=8080
INTERNAL_WEB_URL=http://web:3000
NEXT_PUBLIC_REALTIME_PATH=/ws

WHISPERLIVEKIT_URL=ws://whisperlivekit:8000/asr
WHISPERLIVEKIT_MODEL=small
WHISPERX_MODEL=medium
WHISPERX_BATCH_SIZE=4
WHISPERX_COMPUTE_TYPE=float16
WHISPERX_DEVICE=cuda
HF_TOKEN=
BLOCK_HEAVY_JOBS_WHILE_LIVE=true

NEMOCLAW_SANDBOX=emergency-trial-agent
NEMOCLAW_AGENT_ID=transcript-analyst
OLLAMA_MODEL=qwen3.5:9b
NEMOCLAW_CONTEXT_WINDOW=16384
AGENT_POLL_MS=2000
AGENT_TIMEOUT_MS=900000
AGENT_WORK_ROOT=/var/lib/emergency-trial/agent-jobs

# Development-only: lets /preview demonstrate the UI without Postgres.
PREVIEW_ENABLED=true
